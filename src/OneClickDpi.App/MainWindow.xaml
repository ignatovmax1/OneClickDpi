<Window x:Class="OneClickDpi.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OneClick DPI"
         Icon="Assets\appicon.ico"
        Width="860"
        Height="720"
        MinWidth="720"
        MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackground}"
        Foreground="White"
        FontFamily="Segoe UI">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        </Style>
    </Window.Resources>

    <Grid Margin="36">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel>
                <TextBlock Text="ONECLICK DPI"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource Accent}" />
                <TextBlock Text="Локальное подключение"
                           Margin="0,8,0,0"
                           FontSize="28"
                           FontWeight="SemiBold" />
            </StackPanel>
            <Border HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Padding="14,7"
                    CornerRadius="16"
                    Background="#19233B">
                <TextBlock Text="АВТОМАТИЧЕСКИЙ РЕЖИМ"
                           FontSize="11"
                           Foreground="{StaticResource SecondaryText}"
                           FontWeight="SemiBold" />
            </Border>
        </Grid>

        <Grid Grid.Row="1" Margin="0,25,0,25">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*" />
                <ColumnDefinition Width="0.85*" />
            </Grid.ColumnDefinitions>

            <Border Background="{StaticResource CardBackground}"
                    CornerRadius="24"
                    Padding="28"
                    Margin="0,0,12,0">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusText}"
                               HorizontalAlignment="Center"
                               FontSize="20"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{Binding DetailText}"
                               HorizontalAlignment="Center"
                               Margin="0,8,0,26"
                               Width="310"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource SecondaryText}"
                               FontSize="13" />

                    <Grid Width="176" Height="176" HorizontalAlignment="Center">
                        <Ellipse Fill="#0E1527" Stroke="#263453" StrokeThickness="2" />
                        <Ellipse Margin="12"
                                 Fill="{Binding ButtonBackground}"
                                 Opacity="0.96" />
                        <Button Width="142"
                                Height="142"
                                Click="ToggleButton_Click"
                                IsEnabled="{Binding CanToggle}"
                                Cursor="Hand"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="White"
                                FontSize="18"
                                FontWeight="Bold"
                                Content="{Binding ButtonText}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="71">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>

                    <TextBlock Text="{Binding StrategyText}"
                               Margin="0,24,0,0"
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource SecondaryText}"
                               FontSize="12" />
                </StackPanel>
            </Border>

            <Border Grid.Column="1"
                    Background="{StaticResource CardBackground}"
                    CornerRadius="24"
                    Padding="24"
                    Margin="12,0,0,0">
                <StackPanel>
                    <TextBlock Text="Сервисы"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Margin="0,0,0,12" />

                    <ItemsControl ItemsSource="{Binding Services}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#162139"
                                        CornerRadius="14"
                                        Padding="12"
                                        Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="14"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Detail}"
                                                       Margin="0,4,0,0"
                                                       Foreground="{StaticResource SecondaryText}"
                                                       FontSize="11" />
                                        </StackPanel>
                                        <Ellipse Grid.Column="1"
                                                 Width="10"
                                                 Height="10"
                                                 VerticalAlignment="Center"
                                                 Fill="{Binding Indicator}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Margin="0,5,0,0"
                            Padding="12"
                            Background="#10192C"
                            CornerRadius="12">
                        <TextBlock Text="Discord и видеопотоки YouTube идут напрямую. Через локальный туннель направляются страницы YouTube, Telegram, ChatGPT и Claude."
                                   Foreground="{StaticResource SecondaryText}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   LineHeight="17" />
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                Margin="0,0,0,16"
                Padding="14,10"
                Background="#121A2D"
                CornerRadius="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding UpdateText}"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource SecondaryText}"
                           FontSize="11" />
                <CheckBox Grid.Column="1"
                          Margin="16,0"
                          VerticalAlignment="Center"
                          Content="Ставить при закрытии"
                          IsChecked="{Binding InstallUpdatesOnExit}"
                          Foreground="{StaticResource SecondaryText}"
                          FontSize="11" />
                <Button Grid.Column="2"
                        Padding="14,6"
                        Click="UpdateButton_Click"
                        Content="{Binding UpdateButtonText}"
                        IsEnabled="{Binding CanUseUpdateButton}"
                        Background="{StaticResource Accent}"
                        Foreground="White"
                        BorderThickness="0"
                        FontSize="10"
                        FontWeight="SemiBold"
                        Cursor="Hand" />
            </Grid>
        </Border>

        <Grid Grid.Row="3">
            <TextBlock Text="Windows 10/11 · DPI + выборочный туннель"
                       Foreground="{StaticResource SecondaryText}"
                       FontSize="11" />
            <TextBlock Text="MVP 0.6.6"
                       HorizontalAlignment="Right"
                       Foreground="{StaticResource SecondaryText}"
                       FontSize="11" />
        </Grid>
    </Grid>
</Window>
